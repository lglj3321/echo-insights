# Copy to .env and fill in. Never commit the result.

# --- Database ---------------------------------------------------------------
# Neon PostgreSQL connection string. Without it the API falls back to in-memory
# storage, which is useful locally but resets on every serverless invocation.
# Pooled endpoint recommended: ...-pooler.<region>.aws.neon.tech
DATABASE_URL=postgresql://user:password@ep-example-123456-pooler.eu-central-1.aws.neon.tech/echo_insights?sslmode=require

# --- Authentication ---------------------------------------------------------
# Signing key for JWTs. Generate with: openssl rand -base64 32
# Must be set in production; the code falls back to a development default that
# is safe only because it is public and therefore obviously untrusted.
JWT_SECRET=
JWT_EXPIRES_IN=7d

# --- Runtime ----------------------------------------------------------------
# Local dev server port. Ignored on Vercel, which routes through api/index.ts.
PORT=3000

# --- AI classification (optional) -------------------------------------------
# OpenAI-compatible endpoint used to categorise projects from their
# description. Without these, classification falls back to keyword matching.
AI_INTEGRATIONS_OPENAI_BASE_URL=
AI_INTEGRATIONS_OPENAI_API_KEY=
